;; jolt-net — a portable, dependency-free socket substrate for jolt.
;;
;; Public namespaces are jolt.net / jolt.net.* so this can move into the jolt
;; stdlib unchanged. No third-party runtime deps and no OpenSSL: TLS layers over
;; the byte contract in a separate, optional namespace and must never be required
;; to open a plain TCP socket.
;;
;; Use bin/jnc to select an explicit JOLT_BIN (or the installed `jolt`) and keep
;; this project root stable across subprocess gates. See docs/UPSTREAM-NOTES.md
;; for the shared FFI capabilities required beyond upstream v0.7.1.
;;
;; libc is resolved from the running process (:process true) because the socket
;; and resolver symbols live in the already-loaded process image. The Windows
;; spec is :optional, so it is skipped on other platforms rather than failing.
{:paths ["src"]

 :jolt/native
 [{:name "libc (POSIX sockets, resolver, errno)" :process true}
  {:name "ws2_32" :windows ["ws2_32.dll" "ws2_32"] :optional true}]

 ;; jolt-hegel is test-time only (property/stateful generation via libhegel), so
 ;; it lives in :extra-deps rather than :deps — a property-testing library must
 ;; never become a runtime dependency of a socket layer. Pinned to the reviewed
 ;; v0.1.2 release, whose pointer-based aggregate shim is compatible with the
 ;; current Jolt FFI. Because
 ;; the dep is alias-scoped, the installer needs the alias too:
 ;;   bin/jnc -A:test -m hegel.install
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.chucklehead-dev/jolt-hegel
                               {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
                                :git/sha "ffe523023437862c7e474dc216346426318754c6"}}
                  :main-opts ["-m" "jolt.net.test-main"]}
           :sigpipe {:extra-paths ["test"]
                     :main-opts ["-m" "jolt.net.sigpipe-child"]}
           ;; No :extra-deps at all -- unlike :test, this alias must not
           ;; resolve jolt-hegel (or anything else) before running. Target,
           ;; address, resolver, and blocking-socket coverage only: no poller,
           ;; no POSIX nonblocking calls, no SIGPIPE child. See
           ;; docs/WINDOWS-RUNTIME-SEQUENCE.md task W1.
           :blocking-test {:extra-paths ["test"]
                           :main-opts ["-m" "jolt.net.blocking-test-main"]}
           ;; Task W2. Same dependency-free rule as :blocking-test, and it
           ;; additionally loads no poller test namespace: Windows has no
           ;; readiness backend until WSAPoll in task W3, so a suite that
           ;; quietly required one would be proving POSIX behavior on a
           ;; Windows runner. See docs/WINDOWS-RUNTIME-SEQUENCE.md task W2.
           :nonblocking-test {:extra-paths ["test"]
                              :main-opts ["-m" "jolt.net.nonblocking-test-main"]}
           ;; Task W3. Same dependency-free rule as :blocking-test and
           ;; :nonblocking-test. This one DOES exercise the poller's shared
           ;; token machinery, but over the Windows WSAPoll readiness backend
           ;; and through the internal wake-less adapter. That adapter is still
           ;; a poller built WITHOUT a waker, and its refusals are still what
           ;; this alias proves. See docs/WINDOWS-RUNTIME-SEQUENCE.md task W3.
           :wsapoll-test {:extra-paths ["test"]
                          :main-opts ["-m" "jolt.net.wsapoll-test-main"]}
           ;; Task W4. Same dependency-free rule as the three aliases above.
           ;; Unlike them it drives the PUBLIC jolt.net/open-poller and the
           ;; public blocking accept, because W4's claim is precisely that
           ;; those now work on Windows over an owner-independent wake
           ;; transport. See docs/WINDOWS-RUNTIME-SEQUENCE.md task W4.
           :poller-wake-test {:extra-paths ["test"]
                              :main-opts
                              ["-m" "jolt.net.poller-wake-test-main"]}}

 ;; The wrapper keeps parent and subprocess witnesses on the same native binary.
 :tasks {test "bin/jnc -M:test"}}
