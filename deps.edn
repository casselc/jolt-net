;; jolt-net — a portable, dependency-free socket substrate for jolt.
;;
;; Public namespaces are jolt.net / jolt.net.* so this can move into the jolt
;; stdlib unchanged. No third-party runtime deps and no OpenSSL: TLS layers over
;; the byte contract in a separate, optional namespace and must never be required
;; to open a plain TCP socket.
;;
;; REQUIRES THE LOCAL JOLT FORK. Released joltc v0.4.15 lacks the target,
;; monotonic-clock, errno, 16-bit-type, and scoped array-slice primitives. Use
;; bin/jnc, which points at the fork and fails with a readable message instead of
;; an unbound-var error. See docs/UPSTREAM-NOTES.md.
;;
;; libc is resolved from the running process (:process true) because the socket
;; and resolver symbols live in the already-loaded process image. The Windows
;; spec is :optional, so it is skipped on other platforms rather than failing.
{:paths ["src"]

 :jolt/native
 [{:name "libc (POSIX sockets, resolver, errno)" :process true}
  {:name "ws2_32" :windows ["ws2_32.dll" "ws2_32"] :optional true}]

 ;; jolt-hegel is test-time only (property/stateful generation via libhegel), so
 ;; it lives in :extra-deps rather than :deps — a property-testing library must
 ;; never become a runtime dependency of a socket layer. Pinned to the reviewed
 ;; direct-libhegel branch commit. Because
 ;; the dep is alias-scoped, the installer needs the alias too:
 ;;   bin/jnc -A:test -m hegel.install
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.chucklehead-dev/jolt-hegel
                               {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
                                :git/sha "4910faed4dc86ee54c6afc1a99dcb9a5bca6e840"}}
                  :main-opts ["-m" "jolt.net.test-main"]}
           :sigpipe {:extra-paths ["test"]
                     :main-opts ["-m" "jolt.net.sigpipe-child"]}}

 ;; Deliberately NOT `joltc -M:test`: a bare `joltc` resolves to the stock
 ;; v0.4.15 on PATH, which cannot load this library at all.
 :tasks {test "bin/jnc -M:test"}}
