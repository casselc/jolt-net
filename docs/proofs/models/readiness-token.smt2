; Bounded observable contract for dispatching one native readiness snapshot.
;
; Live source admits a snapshot entry only with a socket lease, drains
; acknowledged mutations after native poll, looks up the current registration
; by the captured registration id, and compares the complete captured/current
; token. Token fields are poller id, registration id, ownership generation, and
; registration revision.
;
; Implementations: 0 is the corrected source relation; 1 omits generation
; equality; 2 omits revision equality; 3 omits current-registration existence;
; 4 omits snapshot-lease admission. Scenario 0 preserves the old raw-fd reuse
; witness with selection/close/reuse/dispatch steps 0/1/2/3.
(set-option :produce-unsat-cores true)

(declare-const implementation Int)
(declare-const scenario Int)
(declare-const observed-dispatch Bool)
(declare-const native-event-count Int)
(declare-const current-registration-count Int)
(declare-const snapshot-lease-count Int)

(declare-const snapshot-poller-id Int)
(declare-const current-poller-id Int)
(declare-const snapshot-registration-id Int)
(declare-const current-registration-id Int)
(declare-const snapshot-generation Int)
(declare-const current-generation Int)
(declare-const snapshot-revision Int)
(declare-const current-revision Int)

; The descriptor and schedule are concrete observables for the generation
; mutant. They do not participate in the token equality itself: generation is
; what distinguishes two owners of the same reused integer descriptor.
(declare-const snapshot-fd Int)
(declare-const current-fd Int)
(declare-const select-step Int)
(declare-const close-step Int)
(declare-const reuse-step Int)
(declare-const dispatch-step Int)

(assert (! (and (<= 0 native-event-count) (<= native-event-count 4))
           :named native-event-count-is-bounded))
(assert (! (and (<= 0 current-registration-count)
                (<= current-registration-count 1))
           :named current-registration-count-is-bounded))
(assert (! (and (<= 0 snapshot-lease-count)
                (<= snapshot-lease-count 1))
           :named snapshot-lease-count-is-bounded))

; Chiasmus config-equivalence reference side. An arithmetic blocker count keeps
; the policy independent from the implementation's conjunctive dispatch rule.
(declare-const reference-blocker-count Int)
(declare-const reference-expected-dispatch Bool)
(declare-const reference-valid Bool)
(assert (! (= reference-blocker-count
              (+ (ite (> native-event-count 0) 0 1)
                 (ite (= current-registration-count 1) 0 1)
                 (ite (= snapshot-lease-count 1) 0 1)
                 (ite (= snapshot-poller-id current-poller-id) 0 1)
                 (ite (= snapshot-registration-id current-registration-id) 0 1)
                 (ite (= snapshot-generation current-generation) 0 1)
                 (ite (= snapshot-revision current-revision) 0 1)))
           :named reference-blocker-count-definition))
(assert (! (= reference-expected-dispatch (= reference-blocker-count 0))
           :named reference-dispatch-definition))
(assert (! (= reference-valid
              (= observed-dispatch reference-expected-dispatch))
           :named reference-classifier-definition))

; Independently derived implementation side. Each selector changes exactly one
; source-shaped conjunct while the other requirements remain in force.
(declare-const implementation-expected-dispatch Bool)
(declare-const implementation-valid Bool)
(assert (! (= implementation-expected-dispatch
              (and (> native-event-count 0)
                   (ite (= implementation 3)
                     true
                     (= current-registration-count 1))
                   (ite (= implementation 4)
                     true
                     (= snapshot-lease-count 1))
                   (= snapshot-poller-id current-poller-id)
                   (= snapshot-registration-id current-registration-id)
                   (ite (= implementation 1)
                     true
                     (= snapshot-generation current-generation))
                   (ite (= implementation 2)
                     true
                     (= snapshot-revision current-revision))))
           :named implementation-dispatch-definition))
(assert (! (= implementation-valid
              (= observed-dispatch implementation-expected-dispatch))
           :named implementation-classifier-definition))

(declare-const readiness-token-violation Bool)
(assert (! (= readiness-token-violation
              (not (= implementation-valid reference-valid)))
           :named violation-definition))

; Corrected consistency query: no bounded observation is classified differently
; by the arithmetic reference and complete-token implementation.
(push 1)
(assert (! (= implementation 0) :named corrected-selector))
(assert (! readiness-token-violation :named corrected-counterexample-query))
(check-sat)
(get-unsat-core)
(pop 1)

; Mutant 1: native readiness selected for generation 9 is dispatched after the
; same fd integer is closed and reused by generation 10.
(push 1)
(assert (= implementation 1))
(assert (= scenario 0))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 9))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert (= snapshot-fd 8))
(assert (= current-fd 8))
(assert (= select-step 0))
(assert (= close-step 1))
(assert (= reuse-step 2))
(assert (= dispatch-step 3))
(assert observed-dispatch)
(assert (not reference-valid))
(assert implementation-valid)
(assert readiness-token-violation)
(check-sat)
(pop 1)

; Mutant 2: an acknowledged interest update advances the current revision, but
; the native snapshot carrying the superseded revision is still dispatched.
(push 1)
(assert (= implementation 2))
(assert (= scenario 1))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 2))
(assert (= current-revision 3))
(assert observed-dispatch)
(assert (not reference-valid))
(assert implementation-valid)
(assert readiness-token-violation)
(check-sat)
(pop 1)

; Mutant 3: an acknowledged removal leaves no current registration, but the old
; ready snapshot is dispatched anyway.
(push 1)
(assert (= implementation 3))
(assert (= scenario 2))
(assert (= native-event-count 1))
(assert (= current-registration-count 0))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert observed-dispatch)
(assert (not reference-valid))
(assert implementation-valid)
(assert readiness-token-violation)
(check-sat)
(pop 1)

; Mutant 4: close wins before snapshot admission, but an entry without a socket
; lease is still allowed to dispatch.
(push 1)
(assert (= implementation 4))
(assert (= scenario 3))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 0))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert observed-dispatch)
(assert (not reference-valid))
(assert implementation-valid)
(assert readiness-token-violation)
(check-sat)
(pop 1)

; Accepted behavior: a live, leased, native-ready snapshot with a complete
; current token is dispatched.
(push 1)
(assert (= implementation 0))
(assert (= scenario 10))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert observed-dispatch)
(assert reference-valid)
(assert implementation-valid)
(check-sat)
(pop 1)

; Valid rejections under the corrected selector: generation mismatch, revision
; mismatch, removal, missing lease, empty native event set, foreign poller id,
; and mismatched registration id.
(push 1)
(assert (= implementation 0))
(assert (= scenario 11))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 9))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert (not observed-dispatch))
(assert reference-valid)
(assert implementation-valid)
(check-sat)
(pop 1)

(push 1)
(assert (= implementation 0))
(assert (= scenario 12))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 2))
(assert (= current-revision 3))
(assert (not observed-dispatch))
(assert reference-valid)
(assert implementation-valid)
(check-sat)
(pop 1)

(push 1)
(assert (= implementation 0))
(assert (= scenario 13))
(assert (= native-event-count 1))
(assert (= current-registration-count 0))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert (not observed-dispatch))
(assert reference-valid)
(assert implementation-valid)
(check-sat)
(pop 1)

(push 1)
(assert (= implementation 0))
(assert (= scenario 14))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 0))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert (not observed-dispatch))
(assert reference-valid)
(assert implementation-valid)
(check-sat)
(pop 1)

(push 1)
(assert (= implementation 0))
(assert (= scenario 15))
(assert (= native-event-count 0))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert (not observed-dispatch))
(assert reference-valid)
(assert implementation-valid)
(check-sat)
(pop 1)

(push 1)
(assert (= implementation 0))
(assert (= scenario 16))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 5))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert (not observed-dispatch))
(assert reference-valid)
(assert implementation-valid)
(check-sat)
