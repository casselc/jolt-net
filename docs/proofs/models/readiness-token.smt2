(push 1)
(assert (= implementation 0))
(assert (= scenario 17))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 8))
(assert (= snapshot-generation 10))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert (not observed-dispatch))
(assert reference-valid)
(assert implementation-valid)
(check-sat)
(pop 1)

; Invalid behavior under the corrected relation: a reused-fd generation
; mismatch is nevertheless observed as dispatched.
(push 1)
(assert (= implementation 0))
(assert (= scenario 18))
(assert (= native-event-count 1))
(assert (= current-registration-count 1))
(assert (= snapshot-lease-count 1))
(assert (= snapshot-poller-id 4))
(assert (= current-poller-id 4))
(assert (= snapshot-registration-id 7))
(assert (= current-registration-id 7))
(assert (= snapshot-generation 9))
(assert (= current-generation 10))
(assert (= snapshot-revision 3))
(assert (= current-revision 3))
(assert observed-dispatch)
(assert (not reference-valid))
(assert (not implementation-valid))
(check-sat)
(pop 1)
