; Bounded observable contract for one listener close and one accept-owned poller.
;
; await-case 0 is an await active during the terminal callback; await-case 1 is
; an await attempted after that callback returns. callback-order 0 is terminal
; first and 1 is ordinary registration removal first. Counts are bounded to one.
; poller phase is 0=open, 1=closed, 2=closing. await-release-source is
; 0=independent wake pipe or 1=listener native close. The latter source forms a
; cycle for an active await because handle close invokes callbacks before native
; close, while the terminal callback waits for poller close to complete.
;
; Implementations: 0 is corrected; 1 omits the terminal callback; 2 loses the
; neighboring ordinary callback during reentrant removal; 3 treats terminal
; poller close as a stop request and returns before the active await exits; 4
; leaves lifecycle open and admits a late await; 5 makes active-await release
; depend on listener native close and therefore cannot return.
(set-option :produce-unsat-cores true)

(declare-const implementation Int)
(declare-const scenario Int)
(declare-const await-case Int)
(declare-const callback-order Int)
(declare-const terminal-callback-count Int)
(declare-const ordinary-callback-count Int)
(declare-const poller-phase-after-terminal Int)
(declare-const active-await-count Int)
(declare-const active-await-exit-count Int)
(declare-const late-await-attempt-count Int)
(declare-const late-await-admission-count Int)
(declare-const await-release-source Int)
(declare-const listener-close-return-count Int)

(assert (! (and (<= 0 implementation) (<= implementation 5))
           :named implementation-is-bounded))
(assert (! (and (<= 0 await-case) (<= await-case 1))
           :named await-case-is-bounded))
(assert (! (and (<= 0 callback-order) (<= callback-order 1))
           :named callback-order-is-bounded))
(assert (! (and (<= 0 terminal-callback-count)
                (<= terminal-callback-count 1))
           :named terminal-callback-count-is-bounded))
(assert (! (and (<= 0 ordinary-callback-count)
                (<= ordinary-callback-count 1))
           :named ordinary-callback-count-is-bounded))
(assert (! (and (<= 0 poller-phase-after-terminal)
                (<= poller-phase-after-terminal 2))
           :named poller-phase-is-bounded))
(assert (! (and (<= 0 active-await-count) (<= active-await-count 1))
           :named active-await-count-is-bounded))
(assert (! (and (<= 0 active-await-exit-count)
                (<= active-await-exit-count 1))
           :named active-await-exit-count-is-bounded))
(assert (! (and (<= 0 late-await-attempt-count)
                (<= late-await-attempt-count 1))
           :named late-await-attempt-count-is-bounded))
(assert (! (and (<= 0 late-await-admission-count)
                (<= late-await-admission-count 1))
           :named late-await-admission-count-is-bounded))
(assert (! (and (<= 0 await-release-source) (<= await-release-source 1))
           :named await-release-source-is-bounded))
(assert (! (and (<= 0 listener-close-return-count)
                (<= listener-close-return-count 1))
           :named listener-close-return-count-is-bounded))

; Chiasmus config-equivalence reference side. The arithmetic penalty count is
; independently shaped from the implementation's explicit scenario relations.
(declare-const reference-penalty-count Int)
(declare-const reference-valid Bool)
(assert (! (= reference-penalty-count
              (+ (ite (= terminal-callback-count 1) 0 1)
                 (ite (= ordinary-callback-count 1) 0 1)
                 (ite (= poller-phase-after-terminal 1) 0 1)
                 (ite (= active-await-count
                         (ite (= await-case 0) 1 0)) 0 1)
                 (ite (= active-await-exit-count
                         (ite (= await-case 0) 1 0)) 0 1)
                 (ite (= late-await-attempt-count
                         (ite (= await-case 1) 1 0)) 0 1)
                 (ite (= late-await-admission-count 0) 0 1)
                 (ite (= await-release-source 0) 0 1)
                 (ite (= listener-close-return-count 1) 0 1)))
           :named reference-penalty-count-definition))
(assert (! (= reference-valid (= reference-penalty-count 0))
           :named reference-classifier-definition))

; Independently derived source-shaped observations for the corrected design and
; each localized mutant. The callback order is deliberately orthogonal: both
; orders must satisfy the same counts and completion relation.
(declare-const implementation-valid Bool)
(assert (! (= implementation-valid
              (ite (= implementation 0)
                (and (= terminal-callback-count 1)
                     (= ordinary-callback-count 1)
                     (= poller-phase-after-terminal 1)
                     (= active-await-count (ite (= await-case 0) 1 0))
                     (= active-await-exit-count (ite (= await-case 0) 1 0))
                     (= late-await-attempt-count (ite (= await-case 1) 1 0))
                     (= late-await-admission-count 0)
                     (= await-release-source 0)
                     (= listener-close-return-count 1))
                (ite (= implementation 1)
                  (and (= await-case 0)
                       (= terminal-callback-count 0)
                       (= ordinary-callback-count 1)
                       (= poller-phase-after-terminal 0)
                       (= active-await-count 1)
                       (= active-await-exit-count 0)
                       (= late-await-attempt-count 0)
                       (= late-await-admission-count 0)
                       (= await-release-source 0)
                       (= listener-close-return-count 1))
                  (ite (= implementation 2)
                    (and (= await-case 0)
                         (= terminal-callback-count 1)
                         (= ordinary-callback-count 0)
                         (= poller-phase-after-terminal 1)
                         (= active-await-count 1)
                         (= active-await-exit-count 1)
                         (= late-await-attempt-count 0)
                         (= late-await-admission-count 0)
                         (= await-release-source 0)
                         (= listener-close-return-count 1))
                    (ite (= implementation 3)
                      (and (= await-case 0)
                           (= terminal-callback-count 1)
                           (= ordinary-callback-count 1)
                           (= poller-phase-after-terminal 1)
                           (= active-await-count 1)
                           (= active-await-exit-count 0)
                           (= late-await-attempt-count 0)
                           (= late-await-admission-count 0)
                           (= await-release-source 0)
                           (= listener-close-return-count 1))
                      (ite (= implementation 4)
                        (and (= await-case 1)
                             (= terminal-callback-count 1)
                             (= ordinary-callback-count 1)
                             (= poller-phase-after-terminal 0)
                             (= active-await-count 0)
                             (= active-await-exit-count 0)
                             (= late-await-attempt-count 1)
                             (= late-await-admission-count 1)
                             (= await-release-source 0)
                             (= listener-close-return-count 1))
                        (and (= implementation 5)
                             (= await-case 0)
                             (= terminal-callback-count 1)
                             (= ordinary-callback-count 1)
                             (= poller-phase-after-terminal 2)
                             (= active-await-count 1)
                             (= active-await-exit-count 0)
                             (= late-await-attempt-count 0)
                             (= late-await-admission-count 0)
                             (= await-release-source 1)
                             (= listener-close-return-count 0))))))))
           :named implementation-classifier-definition))

(declare-const accept-terminal-close-violation Bool)
(assert (! (= accept-terminal-close-violation
              (not (= implementation-valid reference-valid)))
           :named violation-definition))

(push 1)
(assert (! (= implementation 0) :named corrected-selector))
(assert (! accept-terminal-close-violation
           :named corrected-counterexample-query))
(check-sat)
(get-unsat-core)
(pop 1)

