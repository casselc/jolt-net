(assert (= active-await-count 0)) (assert (= active-await-exit-count 0))
(assert (= late-await-attempt-count 1)) (assert (= late-await-admission-count 1))
(assert (= await-release-source 0)) (assert (= listener-close-return-count 1))
(assert (not reference-valid)) (assert implementation-valid)
