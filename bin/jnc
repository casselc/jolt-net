#!/bin/sh
# jnc — run jolt-net against an explicit or installed jolt binary.
#
# JOLT_BIN is authoritative when set. Otherwise use `jolt` from PATH. The test
# main checks every required runtime feature and reports a focused failure.
#
#   bin/jnc -M:test              run the test suite
#   bin/jnc -A:test -m hegel.install   one-time: fetch libhegel
#   bin/jnc repl                 a REPL with the project on the source roots
#
# This wrapper never selects Chez: a native jolt binary owns its own runtime.
set -eu

if [ -n "${JOLT_BIN:-}" ]; then
    JOLT_CMD="$JOLT_BIN"
    if [ ! -x "$JOLT_CMD" ]; then
        echo "jnc: JOLT_BIN=$JOLT_CMD is not executable" >&2
        exit 1
    fi
else
    JOLT_CMD=$(command -v jolt || true)
    if [ -z "$JOLT_CMD" ]; then
        echo "jnc: could not find jolt on PATH; set JOLT_BIN explicitly" >&2
        exit 1
    fi
fi

# Preserve the project root for subprocess gates regardless of caller cwd.
export JOLT_PWD="${JOLT_PWD:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
# The AOT cache key can collide and silently run stale code across edits.
export JOLT_AOT_CACHE="${JOLT_AOT_CACHE:-0}"

exec "$JOLT_CMD" "$@"
