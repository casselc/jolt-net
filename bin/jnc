#!/bin/sh
# jnc — run jolt-net against the local jolt fork.
#
# jolt-net cannot be built by upstream Jolt v0.5.12: it needs the fork's target,
# clock, atomic native-error, 16-bit-type, and scoped array-slice primitives.
# A bare upstream `jolt` on PATH would fail with an unbound-var error far from
# the cause,
# so this wrapper pins the fork and says so plainly if it is missing.
#
#   bin/jnc -M:test              run the test suite
#   bin/jnc -A:test -m hegel.install   one-time: fetch libhegel
#   bin/jnc repl                 a REPL with the project on the source roots
#
# Override the fork location with JOLT_UPSTREAM.
set -eu

# An explicit JOLT_UPSTREAM is authoritative: if it is set but wrong, say so
# rather than silently falling back to a different runtime, which would make the
# override look like it worked.
if [ -n "${JOLT_UPSTREAM:-}" ]; then
    if [ -x "$JOLT_UPSTREAM/bin/jolt" ]; then
        JOLT_BIN="$JOLT_UPSTREAM/bin/jolt"
    elif [ -x "$JOLT_UPSTREAM/bin/joltc" ]; then
        JOLT_BIN="$JOLT_UPSTREAM/bin/joltc"
    else
        echo "jnc: JOLT_UPSTREAM=$JOLT_UPSTREAM has no bin/jolt (or legacy bin/joltc)" >&2
        exit 1
    fi
else
    # Otherwise use the one canonical v0.5.12-candidate rebase worktree. Older
    # proposal worktrees and the plain upstream checkout do not satisfy this
    # branch's exact host/FFI contract; selecting one merely because it has bin/jolt
    # would turn a stale checkout into a misleading partial success.
    for candidate in \
        /home/chuck/ai-src/worktrees/jolt-upstream-rebase-v0.5.12-candidate
    do
        if [ -x "$candidate/bin/jolt" ]; then
            JOLT_UPSTREAM="$candidate"
            JOLT_BIN="$candidate/bin/jolt"
            break
        elif [ -x "$candidate/bin/joltc" ]; then
            JOLT_UPSTREAM="$candidate"
            JOLT_BIN="$candidate/bin/joltc"
            break
        fi
    done
fi

if [ ! -x "${JOLT_BIN:-}" ]; then
    echo "jnc: could not find a jolt fork checkout with bin/jolt." >&2
    echo "jnc: jolt-net requires the local fork's host/FFI primitives on branch" >&2
    echo "     codex/upstream-rebase-v0.5.12-candidate. Upstream Jolt v0.5.12" >&2
    echo "     cannot load this library. Set JOLT_UPSTREAM to the checkout." >&2
    echo "     See docs/UPSTREAM-NOTES.md." >&2
    exit 1
fi

# JOLT_PWD is how Jolt finds THIS project's deps.edn: bin/jolt cd's to the jolt
# repo root so the runtime's relative loads work, and reads the project dir here.
export JOLT_PWD="${JOLT_PWD:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
# The AOT cache key can collide and silently run stale code across edits.
export JOLT_AOT_CACHE="${JOLT_AOT_CACHE:-0}"
export CHEZ="${CHEZ:-scheme}"
export JOLT_CHEZ="${JOLT_CHEZ:-$CHEZ}"

exec "$JOLT_BIN" "$@"
